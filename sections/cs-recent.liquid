{{ 'cs-sections.css' | asset_url | stylesheet_tag }}
<section class="cs-section cs-section--{{ section.settings.background }}" data-cs-recent data-handle="{{ product.handle }}" data-limit="{{ section.settings.limit }}" hidden>
  <div class="page-width">
    <div class="cs-rowhead">
      <div>
        <h2 class="cs-rowhead__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.sub != blank -%}<p class="cs-rowhead__sub">{{ section.settings.sub }}</p>{%- endif -%}
      </div>
    </div>
    {%- capture empty_cards -%}{%- endcapture -%}
    {% render 'cs-rail', cards: empty_cards, label: section.settings.heading %}
  </div>
</section>
{% schema %}
{
  "name": "CS Recently viewed",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed"},
    {"type": "text", "id": "sub", "label": "Subheading", "default": "Pick up where you left off"},
    {"type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8},
    {"type": "select", "id": "background", "label": "Background", "default": "bg", "options": [
      {"value": "bg", "label": "Off-white"}, {"value": "white", "label": "White"}, {"value": "pink", "label": "Soft pink"}]}
  ],
  "presets": [{"name": "CS Recently viewed"}]
}
{% endschema %}
