{{ 'cs-sections.css' | asset_url | stylesheet_tag }}
<section class="cs-section cs-bg-{{ section.settings.background | default: 'bg' }} cs-btn--{{ section.settings.button_color | default: 'green' }}" data-cs-recent data-handle="{{ product.handle }}" data-limit="{{ section.settings.limit }}" hidden>
  <div class="page-width">
    <div class="cs-rowhead">
      <div>
        <h2 class="cs-rowhead__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.sub != blank -%}<p class="cs-rowhead__sub">{{ section.settings.sub }}</p>{%- endif -%}
      </div>
    </div>
    {%- capture empty_cards -%}{%- endcapture -%}
    {% render 'cs-rail', cards: empty_cards, label: section.settings.heading %}
  </div>
</section>
{% schema %}
{
  "name": "CS Recently viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently viewed"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subheading",
      "default": "Pick up where you left off"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "bg",
      "options": [
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "pink",
          "label": "Soft pink"
        },
        {
          "value": "pinkdeep",
          "label": "Pink"
        },
        {
          "value": "lavender",
          "label": "Lavender"
        },
        {
          "value": "peach",
          "label": "Peach"
        },
        {
          "value": "blue",
          "label": "Baby blue"
        },
        {
          "value": "gradient",
          "label": "Gradient: pink to lavender"
        },
        {
          "value": "gradient2",
          "label": "Gradient: peach to pink"
        },
        {
          "value": "gradient3",
          "label": "Gradient: blue to lavender"
        }
      ]
    },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button colour",
      "default": "green",
      "options": [
        {
          "value": "green",
          "label": "Sage green"
        },
        {
          "value": "pink",
          "label": "Pink"
        },
        {
          "value": "lavender",
          "label": "Lavender"
        },
        {
          "value": "black",
          "label": "Black"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CS Recently viewed"
    }
  ]
}
{% endschema %}
