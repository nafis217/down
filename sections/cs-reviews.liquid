{{ 'cs-sections.css' | asset_url | stylesheet_tag }}
<section class="cs-section">
  <div class="page-width">
    {% render 'cs-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, sub: section.settings.sub %}
    {%- if section.settings.rating != blank -%}
      <div class="cs-rsum"><strong>{{ section.settings.rating }}</strong><span class="cs-stars" aria-hidden="true">★★★★★</span><span>{{ section.settings.count_text }}</span></div>
    {%- endif -%}
    <div class="cs-carousel" data-cs-carousel data-autoplay="{{ section.settings.autoplay }}" role="region" aria-roledescription="carousel" aria-label="Customer reviews" tabindex="0">
      <div class="cs-track" data-cs-track>
        {%- for block in section.blocks -%}
          <article class="cs-review" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '340px', alt: 'Photo from ' | append: block.settings.author }}
            {%- endif -%}
            <div class="cs-stars" aria-label="{{ block.settings.stars }} out of 5 stars">{% for i in (1..5) %}{% if i <= block.settings.stars %}★{% else %}☆{% endif %}{% endfor %}</div>
            <p>{{ block.settings.text }}</p>
            <div class="cs-review__by">{{ block.settings.author }}</div>
            {%- if block.settings.verified -%}<div class="cs-review__ver">✓ Verified buyer</div>{%- endif -%}
          </article>
        {%- endfor -%}
      </div>
      <div class="cs-nav">
        <button type="button" data-cs-prev aria-label="Previous review">‹</button>
        <button type="button" data-cs-next aria-label="Next review">›</button>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "CS Reviews carousel",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Badge", "default": "Reviews"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "What customers say"},
    {"type": "text", "id": "sub", "label": "Subheading"},
    {"type": "text", "id": "rating", "label": "Average rating (real only, empty hides summary)"},
    {"type": "text", "id": "count_text", "label": "Count text (real only)", "default": "based on real reviews"},
    {"type": "checkbox", "id": "autoplay", "label": "Auto-advance (pauses on touch/hover)", "default": true}
  ],
  "blocks": [{"type": "review", "name": "Review", "settings": [
    {"type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5},
    {"type": "textarea", "id": "text", "label": "Review text", "default": "[PLACEHOLDER] Paste a REAL customer review here."},
    {"type": "text", "id": "author", "label": "Name", "default": "[Real customer name]"},
    {"type": "image_picker", "id": "image", "label": "Photo review"},
    {"type": "checkbox", "id": "verified", "label": "Show 'Verified buyer' (only if true)", "default": false}
  ]}],
  "presets": [{"name": "CS Reviews carousel", "blocks": [{"type": "review"}, {"type": "review"}, {"type": "review"}]}]
}
{% endschema %}
