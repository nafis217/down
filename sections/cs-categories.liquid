{{ 'cs-sections.css' | asset_url | stylesheet_tag }}
<section class="cs-section cs-section--tight cs-bg-{{ section.settings.background | default: 'bg' }} cs-btn--{{ section.settings.button_color | default: 'green' }}">
  <div class="page-width">
    {% render 'cs-head', heading: section.settings.heading %}
    <ul class="cs-cats" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {%- assign chip_target = block.settings.link | default: '/collections/all' -%}
          {%- capture chip_url -%}{% render 'cs-link-url', target: chip_target %}{%- endcapture -%}
          <a href="{{ chip_url | strip }}" class="cs-cat">
            <span class="cs-cat__chip cs-cat__chip--{{ block.settings.color }}">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}
                {% render 'cs-icon', name: block.settings.icon, size: 34 %}
              {%- endif -%}
            </span>
            <span class="cs-cat__label">{{ block.settings.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
