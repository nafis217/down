{{ 'cs-sections.css' | asset_url | stylesheet_tag }}
<section id="faq" class="cs-section cs-bg-{{ section.settings.background | default: 'pink' }} cs-btn--{{ section.settings.button_color | default: 'green' }}">
  <div class="page-width">
    {% render 'cs-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, sub: section.settings.sub %}
    <div class="cs-faq cs-reveal">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="cs-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
</script>
{% schema %}
{
  "name": "CS FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Badge",
      "default": "Questions?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "pink",
      "options": [
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "pink",
          "label": "Soft pink"
        },
        {
          "value": "pinkdeep",
          "label": "Pink"
        },
        {
          "value": "lavender",
          "label": "Lavender"
        },
        {
          "value": "peach",
          "label": "Peach"
        },
        {
          "value": "blue",
          "label": "Baby blue"
        },
        {
          "value": "gradient",
          "label": "Gradient: pink to lavender"
        },
        {
          "value": "gradient2",
          "label": "Gradient: peach to pink"
        },
        {
          "value": "gradient3",
          "label": "Gradient: blue to lavender"
        }
      ]
    },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button colour",
      "default": "green",
      "options": [
        {
          "value": "green",
          "label": "Sage green"
        },
        {
          "value": "pink",
          "label": "Pink"
        },
        {
          "value": "lavender",
          "label": "Lavender"
        },
        {
          "value": "black",
          "label": "Black"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We ship to the USA and the Philippines. Shipping options and delivery times are shown at checkout, and you'll get a tracking link by email once your order ships.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CS FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>We ship to the USA and the Philippines. Shipping options and delivery times are shown at checkout, and you'll get a tracking link by email once your order ships.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>If something isn't right, email <a href=\"mailto:support@pickora.com\">support@pickora.com</a> and we'll help with a return or refund. Our full refund policy is linked in the footer.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How do I track my order?",
            "answer": "<p>Use the Track Order link in the menu, or the tracking link in your shipping email.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How can I contact you?",
            "answer": "<p>Email <a href=\"mailto:support@pickora.com\">support@pickora.com</a>, Mon–Fri 9am–6pm. We usually reply within a day.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
