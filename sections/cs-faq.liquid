{{ 'cs-sections.css' | asset_url | stylesheet_tag }}
<section class="cs-section cs-section--blush">
  <div class="page-width">
    {% render 'cs-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, sub: section.settings.sub %}
    <div class="cs-faq cs-reveal">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="cs-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
</script>
{% schema %}
{
  "name": "CS FAQ",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Badge", "default": "Questions?"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Good to know"},
    {"type": "text", "id": "sub", "label": "Subheading"}
  ],
  "blocks": [{"type": "faq", "name": "Question", "settings": [
    {"type": "text", "id": "question", "label": "Question", "default": "Question"},
    {"type": "richtext", "id": "answer", "label": "Answer", "default": "<p>[PLACEHOLDER] Answer honestly.</p>"}
  ]}],
  "presets": [{"name": "CS FAQ", "blocks": [
    {"type": "faq", "settings": {"question": "How long does shipping take?"}},
    {"type": "faq", "settings": {"question": "What is your return policy?"}},
    {"type": "faq", "settings": {"question": "How do I use it?"}},
    {"type": "faq", "settings": {"question": "Is there a warranty?"}}
  ]}]
}
{% endschema %}
