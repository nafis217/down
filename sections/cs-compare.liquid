{{ 'cs-sections.css' | asset_url | stylesheet_tag }}
<section class="cs-section">
  <div class="page-width">
    {% render 'cs-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, sub: section.settings.sub %}
    <table class="cs-compare cs-reveal">
      <thead><tr><th scope="col"><span class="visually-hidden">Feature</span></th><th scope="col">{{ section.settings.us_label }}</th><th scope="col">{{ section.settings.them_label }}</th></tr></thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row" style="font-weight:500">{{ block.settings.feature }}</th>
            <td class="{% if block.settings.us %}cs-yes{% else %}cs-no{% endif %}"><span aria-hidden="true">{% if block.settings.us %}✓{% else %}✕{% endif %}</span><span class="visually-hidden">{% if block.settings.us %}Yes{% else %}No{% endif %}</span></td>
            <td class="{% if block.settings.them %}cs-yes{% else %}cs-no{% endif %}"><span aria-hidden="true">{% if block.settings.them %}✓{% else %}✕{% endif %}</span><span class="visually-hidden">{% if block.settings.them %}Yes{% else %}No{% endif %}</span></td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</section>
{% schema %}
{
  "name": "CS Comparison table",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Badge", "default": "Compare"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Us vs. ordinary alternatives"},
    {"type": "text", "id": "sub", "label": "Subheading"},
    {"type": "text", "id": "us_label", "label": "Our column", "default": "Us"},
    {"type": "text", "id": "them_label", "label": "Other column", "default": "Others"}
  ],
  "blocks": [{"type": "row", "name": "Row", "settings": [
    {"type": "text", "id": "feature", "label": "Feature", "default": "[PLACEHOLDER] Feature"},
    {"type": "checkbox", "id": "us", "label": "We have it", "default": true},
    {"type": "checkbox", "id": "them", "label": "Others have it", "default": false}
  ]}],
  "presets": [{"name": "CS Comparison table", "blocks": [{"type": "row"}, {"type": "row"}, {"type": "row"}, {"type": "row"}]}]
}
{% endschema %}
