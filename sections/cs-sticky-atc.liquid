{{ 'cs-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cs-product.js' | asset_url }}" defer="defer"></script>
{%- if product -%}
<div class="cs-sticky" data-cs-sticky aria-hidden="true">
  <div class="cs-sticky__info">
    <div class="cs-sticky__title">{{ product.title }}</div>
    <div data-cs-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</div>
  </div>
  <button type="button" class="button cs-btn" data-cs-sticky-btn tabindex="-1">{{ section.settings.label }}</button>
</div>
{%- endif -%}
{% schema %}
{
  "name": "CS Sticky add to cart",
  "settings": [{"type": "text", "id": "label", "label": "Button label", "default": "Add to cart"}]
}
{% endschema %}
