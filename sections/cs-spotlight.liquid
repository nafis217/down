{{ 'cs-sections.css' | asset_url | stylesheet_tag }}
{%- assign p = section.settings.product | default: collections.all.products.first -%}
<section class="cs-section">
  <span class="cs-blob cs-blob--mint" style="top:-6rem;left:-8rem"></span>
  <div class="page-width">
    {% render 'cs-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, sub: section.settings.sub %}
    {%- if p != blank -%}
      {%- assign v = p.selected_or_first_available_variant -%}
      <a href="{{ p.url }}" class="cs-spot cs-card cs-reveal">
        <div class="cs-spot__img">
          {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 750px) 40vw, 90vw', alt: p.featured_image.alt | default: p.title }}{%- endif -%}
          {%- if v.compare_at_price > v.price -%}<span class="cs-badge cs-spot__badge">Save {{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price }}%</span>{%- endif -%}
        </div>
        <div class="cs-spot__body">
          <h3>{{ p.title }}</h3>
          <p class="cs-spot__price">{{ v.price | money }}{%- if v.compare_at_price > v.price %} <s>{{ v.compare_at_price | money }}</s>{%- endif -%}</p>
          <p>{{ p.description | strip_html | truncate: 160 }}</p>
          <span class="button cs-btn cs-wiggle">{{ section.settings.label }}</span>
        </div>
      </a>
    {%- else -%}
      <div class="cs-ph" style="min-height:20rem">[PLACEHOLDER] Add a product in Shopify admin, then pick it here.</div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "CS Product spotlight",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Badge", "default": "Our favorite"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Meet the star"},
    {"type": "text", "id": "sub", "label": "Subheading"},
    {"type": "product", "id": "product", "label": "Product (defaults to your first product)"},
    {"type": "text", "id": "label", "label": "Button label", "default": "See details"}
  ],
  "presets": [{"name": "CS Product spotlight"}]
}
{% endschema %}
