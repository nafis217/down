{{ 'cs-sections.css' | asset_url | stylesheet_tag }}
<section class="cs-section" style="padding:3rem 0 5rem">
  <div class="page-width">
    <div class="cs-final cs-reveal">
      <span class="cs-blob cs-blob--blue" style="top:-10rem;right:-8rem"></span>
      <div style="position:relative;z-index:1">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        <a class="button cs-btn cs-wiggle" href="{{ section.settings.url | default: collections.all.products.first.url }}">{{ section.settings.label }}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "CS Final CTA",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Ready to fall in love?"},
    {"type": "text", "id": "text", "label": "Text", "default": "[PLACEHOLDER] Short, honest closing line."},
    {"type": "text", "id": "label", "label": "Button label", "default": "Get yours"},
    {"type": "url", "id": "url", "label": "Button link"}
  ],
  "presets": [{"name": "CS Final CTA"}]
}
{% endschema %}
