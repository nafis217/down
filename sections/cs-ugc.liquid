{{ 'cs-sections.css' | asset_url | stylesheet_tag }}
<section class="cs-section cs-section--blush">
  <div class="page-width">
    {% render 'cs-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, sub: section.settings.sub %}
    <div class="cs-ugc">
      {%- for block in section.blocks -%}
        <figure class="cs-pop" style="--cs-i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: block.settings.caption | default: 'Customer photo' }}
          {%- else -%}
            <div class="cs-ph">[PLACEHOLDER] Real customer photo</div>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "CS Customer photos",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Badge", "default": "Real customers"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Loved by our community"},
    {"type": "text", "id": "sub", "label": "Subheading", "default": "Use only genuine photos shared with permission."}
  ],
  "blocks": [{"type": "photo", "name": "Photo", "limit": 12, "settings": [
    {"type": "image_picker", "id": "image", "label": "Photo"},
    {"type": "text", "id": "caption", "label": "Caption / @handle"}
  ]}],
  "presets": [{"name": "CS Customer photos", "blocks": [{"type": "photo"}, {"type": "photo"}, {"type": "photo"}, {"type": "photo"}]}]
}
{% endschema %}
