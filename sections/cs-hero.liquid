{{ 'cs-hero.css' | asset_url | stylesheet_tag }}
<section class="cs-hero cs-bg-{{ section.settings.background | default: 'gradient' }} cs-btn--{{ section.settings.button_color | default: 'green' }}">
  <div class="page-width cs-hero__grid">
    <div class="cs-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="cs-badge">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="cs-hero__title">
        {%- assign words = section.settings.heading | split: ' ' -%}
        {%- for w in words -%}<span class="cs-word" style="--i:{{ forloop.index0 }}">{{ w }}</span>{% unless forloop.last %} {% endunless %}{%- endfor -%}
      </h1>
      <p class="cs-hero__sub">{{ section.settings.subheading }}</p>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="button cs-hero__cta">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta_note != blank -%}<p class="cs-hero__note">{{ section.settings.cta_note }}</p>{%- endif -%}
    </div>
    <div class="cs-hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 45vw, 90vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}
      {%- else -%}
        <div class="cs-hero__art" aria-hidden="true"><span></span><span></span><span></span></div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "CS Hero",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Tag",
      "default": "Trending now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Viral finds you'll actually love"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheadline",
      "default": "Fresh, fun picks that are trending right now. Shop the latest drops."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "Small note under button"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "gradient",
      "options": [
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "pink",
          "label": "Soft pink"
        },
        {
          "value": "pinkdeep",
          "label": "Pink"
        },
        {
          "value": "lavender",
          "label": "Lavender"
        },
        {
          "value": "peach",
          "label": "Peach"
        },
        {
          "value": "blue",
          "label": "Baby blue"
        },
        {
          "value": "gradient",
          "label": "Gradient: pink to lavender"
        },
        {
          "value": "gradient2",
          "label": "Gradient: peach to pink"
        },
        {
          "value": "gradient3",
          "label": "Gradient: blue to lavender"
        }
      ]
    },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button colour",
      "default": "green",
      "options": [
        {
          "value": "green",
          "label": "Sage green"
        },
        {
          "value": "pink",
          "label": "Pink"
        },
        {
          "value": "lavender",
          "label": "Lavender"
        },
        {
          "value": "black",
          "label": "Black"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CS Hero"
    }
  ]
}
{% endschema %}
