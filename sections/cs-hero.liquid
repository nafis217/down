{{ 'cs-hero.css' | asset_url | stylesheet_tag }}
<section class="cs-hero" data-cs-tilt>
  <span class="cs-blob" style="top:-6rem;left:-8rem"></span>
  <span class="cs-blob cs-blob--blue" style="bottom:-8rem;right:-6rem"></span>
  <div class="page-width cs-hero__grid">
    <div class="cs-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="cs-badge">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="cs-hero__title">
        {%- assign words = section.settings.heading | split: ' ' -%}
        {%- for w in words -%}<span class="cs-word" style="--i:{{ forloop.index0 }}">{{ w }}</span>{% unless forloop.last %} {% endunless %}{%- endfor -%}
      </h1>
      <p class="cs-hero__sub">{{ section.settings.subheading }}</p>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.product.url | default: section.settings.cta_url | default: collections.all.products.first.url }}" class="button cs-btn cs-hero__cta cs-wiggle">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta_note != blank -%}<p class="cs-hero__note">{{ section.settings.cta_note }}</p>{%- endif -%}
      {%- if section.settings.rating != blank or section.settings.proof_text != blank -%}
        <div class="cs-hero__proof">
          {%- if section.settings.rating != blank -%}<span class="cs-stars" aria-hidden="true">★★★★★</span><span>{{ section.settings.rating }}/5</span>{%- endif -%}
          {%- if section.settings.proof_text != blank -%}<span>{{ section.settings.proof_text }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="cs-hero__media">
      {%- for block in section.blocks -%}
        <span class="cs-sticker" data-cs-sticker {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {%- endfor -%}
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: class: 'cs-float', widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 45vw, 90vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}
      {%- else -%}
        <div class="cs-ph cs-float" style="width:min(100%,40rem);aspect-ratio:1;border-radius:var(--cs-radius)">[PLACEHOLDER] Add your product photo (transparent PNG or lifestyle shot)</div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "CS Hero",
  "tag": "div",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Small badge", "default": "New • Cute & useful"},
    {"type": "text", "id": "heading", "label": "Headline (words reveal one by one)", "default": "Meet your new favorite little helper"},
    {"type": "textarea", "id": "subheading", "label": "Subheadline", "default": "[PLACEHOLDER] One sentence on the main benefit of your product."},
    {"type": "image_picker", "id": "image", "label": "Product image"},
    {"type": "text", "id": "cta_label", "label": "Button label", "default": "Get yours"},
    {"type": "product", "id": "product", "label": "Product the button goes to (defaults to your first product)"},
    {"type": "url", "id": "cta_url", "label": "Or custom link"},
    {"type": "text", "id": "cta_note", "label": "Note under button", "default": "[PLACEHOLDER] e.g. Ships in X–Y days · 30-day returns"},
    {"type": "text", "id": "rating", "label": "Star rating (real number only, leave empty to hide)"},
    {"type": "text", "id": "proof_text", "label": "Social proof line (real numbers only, leave empty to hide)"}
  ],
  "blocks": [
    {"type": "sticker", "name": "Sticker badge", "limit": 3, "settings": [{"type": "text", "id": "text", "label": "Text", "default": "✨ Sticker text"}]}
  ],
  "presets": [{"name": "CS Hero", "blocks": [{"type": "sticker", "settings": {"text": "💕 Sticker one"}}, {"type": "sticker", "settings": {"text": "✨ Sticker two"}}, {"type": "sticker", "settings": {"text": "🎀 Sticker three"}}]}]
}
{% endschema %}
