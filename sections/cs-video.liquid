{{ 'cs-sections.css' | asset_url | stylesheet_tag }}
<section class="cs-section cs-section--blush">
  <span class="cs-blob cs-blob--mint" style="top:-8rem;right:-8rem"></span>
  <div class="page-width">
    {% render 'cs-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, sub: section.settings.sub %}
    <div class="cs-video cs-reveal" data-cs-video>
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: '600x', autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none', poster: section.settings.poster, class: 'cs-video__el' }}
        <button type="button" class="cs-video__sound" aria-pressed="false" aria-label="Turn sound on">🔇</button>
      {%- else -%}
        <div class="cs-ph">[PLACEHOLDER] Upload a short looping product video (under ~5 MB, 9:16)</div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "CS Demo video",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Badge", "default": "See it in action"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Watch it work"},
    {"type": "text", "id": "sub", "label": "Subheading"},
    {"type": "video", "id": "video", "label": "Video (Shopify-hosted, compressed)"},
    {"type": "image_picker", "id": "poster", "label": "Poster image"}
  ],
  "presets": [{"name": "CS Demo video"}]
}
{% endschema %}
