{{ 'cs-contact.css' | asset_url | stylesheet_tag }}
<section class="cs-contact">
  <div class="cs-contact__hero">
    <div class="page-width">
      {%- if section.settings.eyebrow != blank -%}<span class="cs-badge">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="cs-contact__title">{{ section.settings.heading }}</h1>
      <p class="cs-contact__sub">{{ section.settings.subheading }}</p>
    </div>
  </div>

  <div class="page-width cs-contact__grid">
    <div class="cs-contact__info">
      {%- for block in section.blocks -%}
        {%- capture href -%}
          {%- if block.settings.link contains '@' -%}mailto:{{ block.settings.link | remove: 'mailto:' }}
          {%- elsif block.settings.link != blank -%}{% render 'cs-link-url', target: block.settings.link %}{%- endif -%}
        {%- endcapture -%}
        {%- assign href = href | strip -%}
        <div class="cs-info cs-reveal" style="--cs-i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="cs-cat__chip cs-cat__chip--{{ block.settings.color }}">{% render 'cs-icon', name: block.settings.icon, size: 26 %}</span>
          <div>
            <h2 class="cs-info__title">{{ block.settings.title }}</h2>
            <p class="cs-info__text">
              {%- if href != blank -%}<a href="{{ href }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
            </p>
          </div>
        </div>
      {%- endfor -%}
      {%- if page.content != blank -%}<div class="cs-contact__rte rte">{{ page.content }}</div>{%- endif -%}
    </div>

    <div class="cs-formcard cs-reveal">
      <h2 class="cs-formcard__title">{{ section.settings.form_title }}</h2>
      {%- form 'contact', id: 'CsContactForm', class: 'cs-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="cs-form__ok" role="status" tabindex="-1" autofocus>
            {% render 'cs-icon', name: 'heart', size: 24 %}<span>{{ section.settings.success }}</span>
          </div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="cs-form__err" role="alert">
            <strong>{{ 'templates.contact.form.error_heading' | t }}</strong>
            <ul>{%- for field in form.errors -%}<li>{%- if field == 'form' -%}{{ form.errors.messages[field] }}{%- else -%}{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}{%- endif -%}</li>{%- endfor -%}</ul>
          </div>
        {%- endif -%}
        <div class="cs-form__row">
          <div class="cs-field">
            <label for="CsName">Name</label>
            <input id="CsName" type="text" name="contact[Name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Your name">
          </div>
          <div class="cs-field">
            <label for="CsEmail">Email <span aria-hidden="true">*</span></label>
            <input id="CsEmail" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="you@example.com"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
          </div>
        </div>
        <div class="cs-form__row">
          <div class="cs-field">
            <label for="CsOrder">Order number <small>(optional)</small></label>
            <input id="CsOrder" type="text" name="contact[Order number]" placeholder="#1001">
          </div>
          <div class="cs-field">
            <label for="CsPhone">Phone <small>(optional)</small></label>
            <input id="CsPhone" type="tel" name="contact[Phone number]" autocomplete="tel" placeholder="+1 or +63">
          </div>
        </div>
        <div class="cs-field">
          <label for="CsBody">How can we help? <span aria-hidden="true">*</span></label>
          <textarea id="CsBody" rows="6" name="contact[body]" required placeholder="Tell us a little about your question">{{ form.body }}</textarea>
        </div>
        <button type="submit" class="button cs-form__btn">{{ section.settings.button }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "CS Contact",
  "tag": "div",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Tag", "default": "Contact us"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "We'd love to hear from you"},
    {"type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about an order, a product or shipping? Send us a message and we'll help."},
    {"type": "text", "id": "form_title", "label": "Form heading", "default": "Send us a message"},
    {"type": "text", "id": "button", "label": "Button label", "default": "Send message"},
    {"type": "text", "id": "success", "label": "Success message", "default": "Thanks for reaching out! Our team will get back to you soon."}
  ],
  "blocks": [{"type": "info", "name": "Info card", "settings": [
    {"type": "select", "id": "icon", "label": "Icon", "default": "chat", "options": [
      {"value": "chat", "label": "Chat"}, {"value": "truck", "label": "Truck"}, {"value": "return", "label": "Return"}, {"value": "heart", "label": "Heart"}, {"value": "gift", "label": "Gift"}, {"value": "shield", "label": "Shield"}, {"value": "lock", "label": "Lock"}]},
    {"type": "select", "id": "color", "label": "Colour", "default": "pink", "options": [
      {"value": "pink", "label": "Pink"}, {"value": "peach", "label": "Peach"}, {"value": "blue", "label": "Baby blue"}, {"value": "lavender", "label": "Lavender"}, {"value": "green", "label": "Green"}]},
    {"type": "text", "id": "title", "label": "Title", "default": "Title"},
    {"type": "text", "id": "text", "label": "Text", "default": "Text"},
    {"type": "text", "id": "link", "label": "Link (email address or path, optional)"}
  ]}],
  "presets": [{"name": "CS Contact", "blocks": [
    {"type": "info", "settings": {"icon": "chat", "color": "pink", "title": "Email us", "text": "support@pickora.com", "link": "support@pickora.com"}},
    {"type": "info", "settings": {"icon": "heart", "color": "lavender", "title": "Support hours", "text": "Mon–Fri, 9am–6pm"}},
    {"type": "info", "settings": {"icon": "return", "color": "green", "title": "Response time", "text": "We reply within 24 hours"}},
    {"type": "info", "settings": {"icon": "truck", "color": "blue", "title": "Where is my order?", "text": "Track your order", "link": "/pages/track-order"}}
  ]}]
}
{% endschema %}
