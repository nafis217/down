{{ 'cs-contact.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign socials = ''
  if settings.social_instagram_link != blank
    assign socials = socials | append: 'instagram,'
  endif
  if settings.social_tiktok_link != blank
    assign socials = socials | append: 'tiktok,'
  endif
  if settings.social_facebook_link != blank
    assign socials = socials | append: 'facebook,'
  endif
-%}
<section class="cs-contact cs-btn--{{ section.settings.button_color | default: 'green' }}">
  <div class="cs-contact__hero cs-bg-{{ section.settings.background | default: 'gradient' }}">
    <div class="page-width">
      <h1 class="cs-contact__logo">
        <span aria-hidden="true">{{ section.settings.logo_text }}<i class="cs-contact__dot"></i></span>
        <span class="visually-hidden">{{ shop.name }} – Contact us</span>
      </h1>
      <p class="cs-contact__sub">{{ section.settings.subheading }}</p>
    </div>
  </div>

  <div class="page-width cs-contact__grid">
    <div class="cs-formcard cs-reveal">
      <h2 class="cs-formcard__title">{{ section.settings.form_title }}</h2>
      {%- form 'contact', id: 'CsContactForm', class: 'cs-form', novalidate: 'novalidate' -%}
        {%- if form.posted_successfully? -%}
          <div class="cs-form__ok" role="status" tabindex="-1" autofocus>
            {% render 'cs-icon', name: 'heart', size: 24 %}<span>{{ section.settings.success }}</span>
          </div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="cs-form__err" role="alert">
            <strong>Please check the form:</strong>
            <ul>{%- for field in form.errors -%}<li>{%- if field == 'form' -%}{{ form.errors.messages[field] }}{%- else -%}{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}{%- endif -%}</li>{%- endfor -%}</ul>
          </div>
        {%- endif -%}
        <div class="cs-form__row">
          <div class="cs-field">
            <label for="CsName">Name</label>
            <input id="CsName" type="text" name="contact[Name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Your name">
          </div>
          <div class="cs-field">
            <label for="CsEmail">Email <span aria-hidden="true">*</span></label>
            <input id="CsEmail" type="email" name="contact[email]" autocomplete="email" required aria-describedby="CsEmailErr" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="you@example.com"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
            <small class="cs-field__err" id="CsEmailErr">Please enter a valid email address.</small>
          </div>
        </div>
        <div class="cs-form__row">
          <div class="cs-field">
            <label for="CsOrder">Order number <small>(optional)</small></label>
            <input id="CsOrder" type="text" name="contact[Order number]" placeholder="#1001">
          </div>
          <div class="cs-field">
            <label for="CsPhone">Phone <small>(optional)</small></label>
            <input id="CsPhone" type="tel" name="contact[Phone number]" autocomplete="tel" placeholder="+1 or +63">
          </div>
        </div>
        <div class="cs-field">
          <label for="CsBody">How can we help? <span aria-hidden="true">*</span></label>
          <textarea id="CsBody" rows="6" name="contact[body]" required aria-describedby="CsBodyErr" placeholder="Tell us a little about your question">{{ form.body }}</textarea>
          <small class="cs-field__err" id="CsBodyErr">Please tell us how we can help.</small>
        </div>
        <button type="submit" class="button cs-form__btn">{{ section.settings.button }}</button>
      {%- endform -%}
    </div>
    <div class="cs-contact__info">
      {%- for block in section.blocks -%}
        {%- capture href -%}
          {%- if block.settings.link contains '@' -%}mailto:{{ block.settings.link | remove: 'mailto:' }}
          {%- elsif block.settings.link != blank -%}{% render 'cs-link-url', target: block.settings.link %}{%- endif -%}
        {%- endcapture -%}
        {%- assign href = href | strip -%}
        <div class="cs-info cs-reveal" style="--cs-i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="cs-cat__chip cs-cat__chip--{{ block.settings.color }}">{% render 'cs-icon', name: block.settings.icon, size: 26 %}</span>
          <div>
            <h2 class="cs-info__title">{{ block.settings.title }}</h2>
            <p class="cs-info__text">
              {%- if href != blank -%}<a href="{{ href }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
            </p>
          </div>
        </div>
      {%- endfor -%}
      {%- if page.content != blank -%}<div class="cs-contact__rte rte">{{ page.content }}</div>{%- endif -%}
    </div>

  </div>

  {%- if socials != blank -%}
    <div class="cs-contact__social">
      <div class="page-width cs-contact__social-inner">
        <p>{{ section.settings.social_text }}</p>
        <ul class="cs-socials" role="list">
          {%- assign list = socials | split: ',' -%}
          {%- for s in list -%}
            {%- if s == blank -%}{%- continue -%}{%- endif -%}
            {%- case s -%}
              {%- when 'instagram' -%}{%- assign url = settings.social_instagram_link -%}{%- assign name = 'Instagram' -%}{%- assign icon = 'icon-instagram.svg' -%}
              {%- when 'tiktok' -%}{%- assign url = settings.social_tiktok_link -%}{%- assign name = 'TikTok' -%}{%- assign icon = 'icon-tiktok.svg' -%}
              {%- when 'facebook' -%}{%- assign url = settings.social_facebook_link -%}{%- assign name = 'Facebook' -%}{%- assign icon = 'icon-facebook.svg' -%}
            {%- endcase -%}
            <li><a href="{{ url }}" class="cs-socials__link cs-socials__link--{{ s }}" target="_blank" rel="noopener" aria-label="{{ name }} (opens in a new tab)">{{ icon | inline_asset_content }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
</section>
