{%- comment -%} Pickora design tokens. Edit values in Theme settings > Pickora. {%- endcomment -%}
{%- assign cs_h = settings.cs_heading_font | default: 'Poppins' -%}
{%- assign cs_b = settings.cs_body_font | default: 'Inter' -%}
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family={{ cs_h | replace: ' ', '+' }}:wght@600;700;800&family={{ cs_b | replace: ' ', '+' }}:wght@400;500;600&display=swap"
  media="print"
  onload="this.media='all'"
>
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ cs_h | replace: ' ', '+' }}:wght@600;700;800&family={{ cs_b | replace: ' ', '+' }}:wght@400;500;600&display=swap">
</noscript>
<style>
  :root {
    --cs-bg: {{ settings.cs_bg | default: '#FFFDF9' }};
    --cs-white: {{ settings.cs_white | default: '#FFFFFF' }};
    --cs-lavender: {{ settings.cs_lavender | default: '#E6DEFA' }};
    --cs-pink: {{ settings.cs_pink | default: '#FFC8DD' }};
    --cs-surface: {{ settings.cs_surface | default: '#FFE3EE' }};
    --cs-peach: {{ settings.cs_peach | default: '#FFD8B5' }};
    --cs-blue: {{ settings.cs_blue | default: '#CDE7FF' }};
    --cs-mint: {{ settings.cs_cta | default: '#A8E6B5' }};
    --cs-cta: {{ settings.cs_cta | default: '#A8E6B5' }};
    --cs-cta-hover: {{ settings.cs_cta_hover | default: '#8FD9A8' }};
    --cs-cta-text: {{ settings.cs_cta_text | default: '#111111' }};
    --cs-text: {{ settings.cs_text | default: '#111111' }};
    --cs-muted: {{ settings.cs_muted | default: '#444444' }};
    --cs-radius: {{ settings.cs_radius | default: 18 }}px;
    --cs-radius-sm: 12px;
    --cs-btn-radius: 999px;
    --cs-shadow: 0 6px 20px rgba(17, 17, 17, 0.07);
    --cs-shadow-lg: 0 14px 34px rgba(17, 17, 17, 0.12);
    --cs-glow: 0 8px 26px rgba(255, 200, 221, 0.65);
    --cs-font-heading: '{{ cs_h }}', ui-rounded, system-ui, sans-serif;
    --cs-font-body: '{{ cs_b }}', system-ui, -apple-system, sans-serif;
    --cs-ease-soft: cubic-bezier(0.22, 1, 0.36, 1);
    --font-heading-family: var(--cs-font-heading);
    --font-body-family: var(--cs-font-body);
  }
</style>
{%- unless settings.cs_motion -%}
  <style>
    :root { --cs-motion: 0; }
  </style>
{%- endunless -%}
<script>window.cs_money_format = {{ shop.money_format | json }};</script>
